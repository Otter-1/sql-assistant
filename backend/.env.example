# LangGraph
OPENROUTER_API_KEY=«redacted:sk-…»

# PostgreSQL (checkpointer — optionnel pour langgraph up)
DATABASE_URI="postgresql://postgres:***@localhost:5432/checkpointer"

# PostgreSQL source profilée par le loader (backend/src/loader.py)
# Le schéma postgresql+psycopg:// est requis (driver psycopg 3)
SOURCE_DATABASE_URI="postgresql+psycopg://user:password@localhost:5432/mydb"