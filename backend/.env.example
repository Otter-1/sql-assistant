# LangGraph
OPENROUTER_API_KEY=«redacted:sk-…»

# PostgreSQL (checkpointer — optionnel pour langgraph up)
DATABASE_URI="postgresql://postgres:***@localhost:5432/checkpointer"

# Loader (backend/src/loader.py): HOT-SWAPPABLE, pas de variable d'environnement.
# Le URI de la base cible est passé à chaque appel (une exécution par base) :
#   python src/loader.py --uri postgresql+psycopg://user:password@localhost:5432/mydb